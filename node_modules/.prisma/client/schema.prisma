generator client {
  provider = "prisma-client-js"
}

// O datasource deve ficar aqui, no nível principal
datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Agora vêm os modelos
model Device {
  id           String       @id @default(uuid())
  glpiId       Int          @unique
  name         String
  serialNumber String?
  locationId   Int?
  preventives  Preventive[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Preventive {
  id         String   @id @default(uuid())
  date       DateTime
  technician String
  notes      String?
  device     Device   @relation(fields: [deviceId], references: [id])
  deviceId   String
}

model User {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique
  password String
  name     String
}
